# =========================================================================
# Git Ignore — OwO-Desktop
# =========================================================================

# Build output
build/
bin/
out/
FrameworkShaders/
SampleShaders/

# Documentation
docs/
AGENTS.md

# IDE
.vs/
.vscode/
.idea/
*.user
*.suo
*.sln.docstates

# MSVC / CMake generated
CMakeUserPresets.json

# Runtime artifacts
*.log

# Third-party dependencies (managed by CMake FetchContent or manual install)
third_party/Live2D_SDK/**
third_party/DirectXTK/**
third_party/ixwebsocket/**
third_party/ixwebsocket/.git
third_party/nlohmann/**

# Compiled binaries
*.dll
*.lib
*.exe
*.pdb
*.obj
*.exp
*.ilk

# Copyrighted Live2D model assets
assets/models/**

# OS files
Thumbs.db
Desktop.ini

# =========================================================================
# Allow .gitkeep to preserve directory structure
# =========================================================================
!.gitkeep
